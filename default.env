# The settings are in .env, use "nano .env". Don't edit default.env itself.
COMPOSE_FILE=mova.yml

# Label only (no multi-network switch exists in the current movan repo,
# this is just here for metrics/labels consistency with other -docker repos)
NETWORK=movan

DOCKER_TAG=v0.0.1

# --- Ports ---
# P2P must be public or peers will deprioritize this node
P2P_PORT=26656
# Recommended EVM JSON-RPC / WebSocket (faster than the legacy pair below)
RPC_PORT=26660
WS_PORT=26661
# Legacy EVM JSON-RPC / WebSocket - only needed if something still depends on them
RPC_PORT_LEGACY=26658
WS_PORT_LEGACY=26659

# --- Container environment for movan-syncnode ---
# These map to the image's expected ID / READ-TIMEOUT / etc. env vars (see mova.yml).
# Kept dash-free here because dashes in default.env variable names break ./movad's
# env-migration tooling - the dashes get re-added inside mova.yml itself.
MOVA_ID=0
MOVA_READ_TIMEOUT=60
MOVA_WRITE_TIMEOUT=60
MOVA_ENABLE_CROSS_DOMAIN=true
MOVA_ENABLE_LIGHT_NODE=true
MOVA_ENABLE_SYNC_FRAME=false
# Don't change MOVA_ID unless you also update the node-data volume mount in
# mova.yml (it targets /mova/node0, matching ID=0)

# IP of the host you want to use in Docker (in case host has several IPs).
# Used to bind the public P2P port to one specific interface.
HOST_IP=
# IP address to use when host-mapping RPC/WS through mova-shared.yml.
# Set this to 127.0.0.1 to restrict the share to localhost.
SHARE_IP=

# Secure web proxy - advanced use, please see instructions
DOMAIN=example.com
RPC_HOST=mova
RPC_LB=mova-lb
WS_HOST=movaws
WS_LB=movaws-lb

# External Docker network if using ext-network.yml
DOCKER_EXT_NETWORK=traefik_default

# Set a Github tag here to pin the script to a version.
SCRIPT_TAG=

# Used by script update - please do not adjust
ENV_VERSION=1
